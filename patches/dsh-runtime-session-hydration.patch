@@ -0,0 +1,26 @@
+import type { HistoryEntry, SessionId } from '@deepseek-ai/dsh-api-remotes/client'
+import type { SessionListEntry } from '../sessions/lineage.ts'
+
+/** Durable, non-authoritative list facts; live activity and UI projection fields are excluded. */
+export type SessionListSeedEntry = Omit<
+  SessionListEntry,
+  'running' | 'pendingInteraction' | 'completed' | 'depth'
+>
+
+/** Non-authoritative history window supplied before the first live baseline. */
+export interface SessionWindowSeed {
+  entries: readonly HistoryEntry[]
+  hasMore: boolean
+}
+
+/** Authoritative runtime state handed to an optional persistence adapter. */
+export type SessionHydrationCommit =
+  | { kind: 'list'; entries: readonly SessionListSeedEntry[] }
+  | { kind: 'window'; sessionId: SessionId; window: SessionWindowSeed }
+
+/** Product-neutral cold-state seam. Storage format and retention belong to the adapter. */
+export interface SessionHydrationAdapter {
+  readList(): readonly SessionListSeedEntry[] | undefined
+  readWindow(sessionId: SessionId): SessionWindowSeed | undefined
+  committed(change: SessionHydrationCommit): void
+}
