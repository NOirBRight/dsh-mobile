# Public DNS A/AAAA for this hostname must point at this VPS.
RELAY_HOST=relay.example.com
# Domestic builds may use a nearby mirror; overseas builds can use npmjs.
NPM_REGISTRY=https://registry.npmjs.org/
# Keep rooms ephemeral; these are process limits, not user identity limits.
MAX_CONNECTIONS=2048
MAX_ROOMS=4096
MAX_PAYLOAD_BYTES=262144
MAX_BYTES_PER_MIN=16777216
MAX_UPGRADES_PER_IP_PER_MIN=120
